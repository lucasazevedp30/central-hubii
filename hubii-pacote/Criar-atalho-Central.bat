@echo off
cd /d "%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$d=(Get-Location).Path; $w=New-Object -ComObject WScript.Shell; $desk=[Environment]::GetFolderPath('Desktop'); function A($pasta,$nome,$alvo,$ico,$desc){ $s=$w.CreateShortcut($pasta+'\'+$nome+'.lnk'); $s.TargetPath=$d+'\'+$alvo; $s.WorkingDirectory=$d; $s.IconLocation=$d+'\logos\'+$ico; $s.WindowStyle=7; $s.Description=$desc; $s.Save() }; A $desk 'Central Hubii' 'Central-Hubii.bat' 'central.ico' 'Central Hubii - Pet Fun'; A $d 'Atalho - Central Hubii' 'Central-Hubii.bat' 'central.ico' 'Central Hubii - Pet Fun'; A $d 'Atalho - Central antiga' 'Central-antiga.bat' 'central.ico' 'Central Hubii (janela antiga)'; A $d 'Atalho - Descritivos' 'Descritivos.bat' 'descritivos.ico' 'Imprimir descritivos'; A $d 'Atalho - Reimprimir Descritivos' 'Reimprimir-Descritivos.bat' 'descritivos.ico' 'Reimprimir descritivos sem faturar'; A $d 'Atalho - Etiquetas' 'Etiquetas.bat' 'etiquetas.ico' 'Imprimir etiquetas'; A $d 'Atalho - Pendencias' 'Pendencias.bat' 'pendencias.ico' 'Verificar pendencias'"
if errorlevel 1 (echo Nao consegui criar os atalhos.) else (echo Pronto! Atalho "Central Hubii" na Area de Trabalho e atalhos com icone nesta pasta: Descritivos, Etiquetas e Pendencias.)
pause
